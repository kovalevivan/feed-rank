# Конфигурация для эксперимента VK Views
# Скопируйте этот файл в .env в корне проекта или установите переменные окружения

# Токен ВКонтакте для эксперимента (отдельный от основного)
VK_EXPERIMENT_TOKEN=033b5ad1033b5ad1033b5ad18b000beccb0033b033b5ad16b2dd6d4b4dc1ca34cf5232a

# Группы для отслеживания (через запятую, без пробелов)
# Можно использовать как имена групп, так и ID
VK_EXPERIMENT_GROUPS=chp_nn,group2,group3

# Дополнительные настройки (опциональные)
# VK_EXPERIMENT_SHORT_TERM_HOURS=8      # Продолжительность краткосрочного отслеживания в часах
# VK_EXPERIMENT_CHECK_INTERVAL=30       # Интервал проверки в минутах
# VK_EXPERIMENT_POSTS_PER_GROUP=10      # Количество постов для отслеживания на группу
