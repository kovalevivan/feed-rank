# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/feedrank

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# VK API credentials
VK_APP_ID=your_vk_app_id
VK_APP_SECRET=your_vk_app_secret
VK_ACCESS_TOKEN=your_vk_access_token

# Telegram Bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# External PostgreSQL for Telegram analytics
ANALYTICS_DATABASE_URL=postgresql://user:password@host:5432/database
ANALYTICS_DATABASE_SSL=false

# Telegram media storage.
# Telegram gives opaque file ids, not public media URLs. Enable this to download
# photo, image, animation and video attachments during sync and store public URLs
# in Post.attachments. The byte limit protects the Node.js process from very large
# in-memory Telegram downloads (default: 200 MiB).
TELEGRAM_DOWNLOAD_MEDIA_IN_SYNC=false
TELEGRAM_STORE_MEDIA_IN_S3=false
TELEGRAM_MAX_MEDIA_DOWNLOAD_BYTES=209715200
MEDIA_S3_ENDPOINT=https://s3.twcstorage.ru
MEDIA_S3_BUCKET=feed-rank-media
MEDIA_S3_REGION=ru-1
MEDIA_S3_ACCESS_KEY_ID=your_access_key
MEDIA_S3_SECRET_ACCESS_KEY=your_secret_key
MEDIA_S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/feed-rank-media
